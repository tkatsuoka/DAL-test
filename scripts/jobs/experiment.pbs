#!/bin/bash
# PBS job that runs src/experiment.py with the arguments in MYARGS
# (submitted from scripts/ by submit_experiment in common.sh)
#PBS -V
#PBS -S /bin/bash
#PBS -j eo
#PBS -q cpu-large
#PBS -l select=1:ncpus=96:mem=512gb:ompthreads=1

cd "$PBS_O_WORKDIR"
../.venv/bin/python3 ../src/experiment.py $MYARGS
